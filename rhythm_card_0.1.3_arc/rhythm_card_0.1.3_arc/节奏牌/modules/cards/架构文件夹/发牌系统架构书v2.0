const CARD_DATABASE_PATH: String = "res://data/configs/card_database.tres"
const CARD_EFFECTS_PATH: String = "res://data/configs/card_effects.tres"

# 判定结果
const JUDGE_RESULT_NONE: int = 0
const JUDGE_RESULT_PERFECT: int = 1
const JUDGE_RESULT_GOOD: int = 2
const JUDGE_RESULT_MISS: int = 3
