    │               └──► ChargeMediator
    │                       │
    │                       ├──► RhythmAdapter (接口)
    │                       │       └──► RhythmAdapterImpl
    │                       │
    │                       ├──► ChargeCalculator (接口)
    │                       │       └──► StandardCharge
    │                       │
    │                       └──► EffectTrigger
    │                               └──► CardEffect
    │
    ├──► ComboDetector
    │       └──► ComboChecker (接口)
    │
    └──► DealingDriver (接口)
            ├──► ClickDriver
