## 五、核心类详细设计

### 5.1 CardsModule（模块入口）

```gdscript
class_name CardsModule
extends Node

## ========== 常量 ==========
const MAX_HAND_SIZE: int = 10
const CARDS_PER_TURN: int = 3
const COMBO_WINDOW_SIZE: int = 5

const CARD_DATABASE_PATH: String = "res://modules/cards/data/configs/card_database.tres"
const COMBO_DEFINITIONS_PATH: String = "res://modules/cards/data/configs/combo_definitions.tres"

## ========== 内核 ==========
var _card_manager: CardManager

## ========== 服务 ==========
var _draw_driver: DrawDriver             # 可替换的发牌驱动
var _rhythm_port: RhythmPort
var _combo_tracker: ComboTracker
var _effect_registry: EffectRegistry     # 效果 ID → EffectHandler 映射

## ========== 状态 ==========
var _is_initialized: bool = false
var _is_running: bool = false

## ========== 生命周期 ==========

func initialize() -> void:
	if _is_initialized:
		return
	_card_manager = CardManager.new()
	_card_manager.load_database(CARD_DATABASE_PATH)
	_card_manager.set_max_hand_size(MAX_HAND_SIZE)

	_draw_driver = AutoDrawDriver.new(self)
	_rhythm_port = RhythmPort.new(_card_manager)
	_combo_tracker = ComboTracker.new(COMBO_WINDOW_SIZE)
	_combo_tracker.load_definitions(COMBO_DEFINITIONS_PATH)
	_effect_registry = EffectRegistry.new()

	_subscribe_events()
	_is_initialized = true

func start() -> void:
	if not _is_initialized:
		push_error("[CardsModule] 未初始化")
		return
	_is_running = true
	_draw_driver.start()

func stop() -> void:
	_is_running = false
	_draw_driver.stop()

func cleanup() -> void:
	_unsubscribe_events()
	_draw_driver.cleanup()
	_draw_driver = null
	_rhythm_port.cleanup()
	_rhythm_port = null
	_combo_tracker.cleanup()
	_combo_tracker = null
	_effect_registry = null
	_card_manager = null
	_is_initialized = false

## ========== 回合管理 ==========

func start_turn() -> void:
	if not _is_running:
		return
	_card_manager.start_turn(CARDS_PER_TURN)
	EventBus.fire("cards:turn_started", {})

func end_turn() -> void:
	if not _is_running:
		return
	_card_manager.end_turn()
	EventBus.fire("cards:turn_ended", {})

## ========== 发牌驱动注入 ==========

func set_draw_driver(driver: DrawDriver) -> void:
	if _is_running:
		_draw_driver.stop()
	_draw_driver.cleanup()
	_draw_driver = driver
	if _is_running:
		_draw_driver.start()

## ========== 效果处理器注册 ==========

func register_effect_handler(handler: EffectHandler) -> void:
	_effect_registry.register(handler)

## ========== 公共接口 ==========

func get_hand() -> Array[Card]:
	return _card_manager.get_hand()

func get_discard_pile() -> Array[Card]:
	return _card_manager.get_cards_by_stage(Card.Stage.DISCARD)

func play_card(card: Card) -> bool:
	if not _is_running:
		return false
	return _card_manager.play_card(card)

func request_draw() -> void:
	if not _is_running:
		return
	_card_manager.draw_one()

func get_card_data(card_id: String) -> CardData:
	return _card_manager.get_card_data(card_id)

## ========== 事件订阅 ==========
func _subscribe_events() -> void:
	EventBus.listen("cards:card_charged", self, "_on_card_charged")

func _unsubscribe_events() -> void:
	EventBus.unlisten("cards:card_charged", self)

## ========== 效果触发（FIX-4: 接入事件流） ==========
func _on_card_charged(data: Dictionary) -> void:
	var card: Card = data.card
	_combo_tracker.record(card)
	_effect_registry.execute(card)
```

### 5.2 CardManager（内核）

**关键设计原则**：
- `_all_cards` 是唯一容器
- `Card.stage` 是唯一位置信息来源
- `_playing_by_context: Dictionary` 是 rhythm context → Card 的 O(1) 查找表
- 容器查询通过 `get_cards_by_stage()` 过滤，不维护同步副本

```gdscript
class_name CardManager
extends RefCounted

## ========== 常量 ==========
const JUDGE_PERFECT: int = 1
const JUDGE_GOOD: int = 2
const JUDGE_MISS: int = 3

## ========== 唯一容器 ==========
var _all_cards: Array[Card] = []

## ========== O(1) 查找表（FIX-5: O(n) → O(1)） ==========
var _playing_by_context: Dictionary = {}  # rhythm_context_id → Card

## ========== 配置 ==========
var _max_hand_size: int = 10

## ========== 数据库 ==========
var _database: Resource
var _data_cache: Dictionary = {}   # card_id → CardData

## ========== 工具 ==========
var _id_counter: int = 0

func _make_id() -> String:
	_id_counter += 1
	return "card_%09d" % _id_counter

## ========== 数据库加载 ==========

func load_database(path: String) -> void:
	if not ResourceLoader.exists(path):
		push_error("[CardManager] 数据库不存在: " + path)
		return
	_database = load(path)
	# FIX-1: 构建初始牌堆（必须调用，否则 _all_cards 永远为空）
	_build_initial_deck()

## FIX-1: 创建所有卡牌实例填入 _all_cards
## 从数据库加载 CardData，按 quantity 创建对应数量的 Card 实例
func _build_initial_deck() -> void:
	if _database == null:
		return
	var all_data: Array[CardData] = _database.get_all_cards()
	for data: CardData in all_data:
		var quantity: int = data.get("quantity", 1)
		for i in range(quantity):
			var instance_id := _make_id()
			var card := Card.create(data, instance_id)
			_all_cards.append(card)
	_shuffle_deck()

## 将所有 DECK 阶段的卡牌随机打乱顺序
func _shuffle_deck() -> void:
	var deck_cards: Array[Card] = get_cards_by_stage(Card.Stage.DECK)
	for i in range(deck_cards.size()):
		var j := randi() % deck_cards.size()
		var temp: Card = deck_cards[i]
		deck_cards[i] = deck_cards[j]
		deck_cards[j] = temp

func get_card_data(card_id: String) -> CardData:
	if _data_cache.has(card_id):
		return _data_cache[card_id]
	if _database == null:
		return null
	var data: CardData = _database.get_card(card_id)
	if data != null:
		_data_cache[card_id] = data
	return data

func set_max_hand_size(size: int) -> void:
	_max_hand_size = size

## ========== 回合生命周期 ==========

func start_turn(cards_to_draw: int) -> void:
	# 回合开始：把所有在手牌中的卡（来自上一回合未打出的）状态不变
	# 发牌直到达到 cards_to_draw
	for i in range(cards_to_draw):
		if get_cards_by_stage(Card.Stage.HAND).size() >= _max_hand_size:
			break
		_draw_one()

	EventBus.fire("cards:turn_started", {
		"hand_size": get_cards_by_stage(Card.Stage.HAND).size()
	})

func end_turn() -> void:
	# FIX-3: 不需要手动遍历 _hand 设置 stage
	# Card.stage 是唯一来源，end_turn 后这些卡自然通过 stage 被查询到在 discard
	var hand_cards: Array[Card] = get_cards_by_stage(Card.Stage.HAND)
	for card in hand_cards:
		card.stage = Card.Stage.DISCARD
	EventBus.fire("cards:turn_ended", {
		"discard_size": get_cards_by_stage(Card.Stage.DISCARD).size()
	})

## ========== 牌堆操作 ==========

## 发一张牌到手牌
func _draw_one() -> Card:
	var hand_size := get_cards_by_stage(Card.Stage.HAND).size()
	if hand_size >= _max_hand_size:
		return null

	# 牌堆空了 → 从弃牌堆洗入
	var deck_cards: Array[Card] = get_cards_by_stage(Card.Stage.DECK)
	if deck_cards.is_empty():
		_refill_deck_from_discard()

	deck_cards = get_cards_by_stage(Card.Stage.DECK)
	if deck_cards.is_empty():
		return null

	# 从牌堆顶部抽一张
	var card: Card = deck_cards.back()
	card.stage = Card.Stage.HAND

	EventBus.fire("cards:card_drawn", _card_to_dict(card))
	return card

func _refill_deck_from_discard() -> void:
	var discard_cards: Array[Card] = get_cards_by_stage(Card.Stage.DISCARD)
	for card in discard_cards:
		card.stage = Card.Stage.DECK
	_shuffle_deck()
	EventBus.fire("cards:deck_refilled", {
		"count": get_cards_by_stage(Card.Stage.DECK).size()
	})

## ========== 出牌 ==========

func play_card(card: Card) -> bool:
	if card.stage != Card.Stage.HAND:
		return false

	card.stage = Card.Stage.PLAYING

	# 发出 rhythm 启动请求，rhythm_axis 会返回 context_id
	EventBus.fire("cards:request_rhythm_start", {
		"card_instance_id": card.instance_id,
		"card_id": card.data.card_id,
		"required_charge": card.data.required_charge,
		"rhythm_keys": card.data.rhythm_keys,
		"rhythm_timeout": card.data.rhythm_timeout,
		"bpm": 120.0,
	})

	# 注册到 O(1) 查找表（FIX-5），等待 RhythmPort 回填 context_id
	# 注意：context_id 在 rhythm:context_started 事件中由 RhythmPort 回填
	_playing_by_context[card.instance_id] = card

	EventBus.fire("cards:card_played", _card_to_dict(card))
	return true

## ========== 外部驱动：接收 rhythm 判定结果 ==========
## 由 RhythmPort 调用
## FIX-9: context_id 来自 rhythm_axis 回调，不再在 play_card() 中直接设置

func notify_judged(context_id: String, result: int, delta: float) -> void:
	# FIX-5: O(1) 查找（FIX-5 修复的一部分）
	var card: Card = _playing_by_context.get(context_id, null)
	if card == null:
		return
	if card.stage != Card.Stage.PLAYING:
		return

	var charge_amount := _calc_charge(result, delta, card)
	card.add_charge(charge_amount)

	EventBus.fire("cards:charge_updated", {
		"card": card,
		"current": card.current_charge,
		"required": card.data.required_charge,
		"is_completed": card.is_fully_charged(),
	})

	if card.is_fully_charged():
		_complete_card(card, context_id)
	elif _should_fail(card):
		_fail_card(card, context_id)

func _complete_card(card: Card, context_id: String) -> void:
	card.stage = Card.Stage.CHARGED
	_playing_by_context.erase(context_id)
	EventBus.fire("cards:request_rhythm_stop", {"context_id": context_id})
	EventBus.fire("cards:card_charged", {"card": card})

func _fail_card(card: Card, context_id: String) -> void:
	card.stage = Card.Stage.HAND
	_playing_by_context.erase(context_id)
	EventBus.fire("cards:request_rhythm_stop", {"context_id": context_id})
	EventBus.fire("cards:charge_failed", {"card": card})

func discard_card(card: Card) -> void:
	if card.rhythm_context_id != "" and _playing_by_context.has(card.rhythm_context_id):
		_playing_by_context.erase(card.rhythm_context_id)
	card.stage = Card.Stage.EFFECT_USED
	card.current_charge = 0
	card.rhythm_context_id = ""
	EventBus.fire("cards:card_discarded", _card_to_dict(card))

## ========== 辅助 ==========

func _calc_charge(result: int, _delta: float, _card: Card) -> int:
	match result:
		JUDGE_PERFECT, JUDGE_GOOD:
			return 1
		JUDGE_MISS:
			return 0
	return 0

func _should_fail(_card: Card) -> bool:
	return false

func _card_to_dict(card: Card) -> Dictionary:
	return {
		"instance_id": card.instance_id,
		"card_id": card.data.card_id,
		"stage": Card.Stage.keys()[card.stage],
		"charge": card.current_charge,
	}

## ========== 查询接口（FIX-3: 基于 Card.stage 的派生查询） ==========

## 派生查询：按 stage 过滤（由 Card.stage 唯一来源派生）
func get_cards_by_stage(stage: int) -> Array[Card]:
	var result: Array[Card] = []
	for card in _all_cards:
		if card.stage == stage:
			result.append(card)
	return result

func get_hand() -> Array[Card]:
	return get_cards_by_stage(Card.Stage.HAND)

func get_deck() -> Array[Card]:
	return get_cards_by_stage(Card.Stage.DECK)

func get_discard_pile() -> Array[Card]:
	return get_cards_by_stage(Card.Stage.DISCARD)

func find_card(instance_id: String) -> Card:
	for card in _all_cards:
		if card.instance_id == instance_id:
			return card
	return null

## ========== 注册到 O(1) 查找表（FIX-5: 由 RhythmPort 调用） ==========
func register_rhythm_context(context_id: String, card: Card) -> void:
	_playing_by_context[context_id] = card
	card.rhythm_context_id = context_id  # FIX-9: 回填 context_id 到 Card

func unregister_rhythm_context(context_id: String) -> void:
	var card: Card = _playing_by_context.get(context_id, null)
	if card != null:
		card.rhythm_context_id = ""
	_playing_by_context.erase(context_id)
```

### 5.3 Card（实体）

```gdscript
class_name Card
extends RefCounted

## ========== 静态数据 ==========
var data: CardData

## ========== 身份 ==========
var instance_id: String

## ========== 运行时状态（全部在 Card 上，Card.stage 是唯一位置来源） ==========
var stage: Stage = Stage.DECK
var current_charge: int = 0
var rhythm_context_id: String = ""    # FIX-9: 由 RhythmPort 在 rhythm 启动后回填
var combo_tags: Array[String] = []

## ========== 阶段（Card.stage 是唯一位置来源，CardManager 据此派生查询） ==========
enum Stage {
	DECK,       # 在牌堆中
	HAND,       # 在手牌中
	PLAYING,    # 正在节奏轴判定
	CHARGED,    # 充能完成
	DISCARD,    # 在弃牌区
	EFFECT_USED # 效果已触发（不可再用）
}

## ========== 静态工厂（FIX-1: 替代已移除的 CardFactory） ==========
static func create(data: CardData, instance_id: String) -> Card:
	var card := Card.new()
	card.data = data
	card.instance_id = instance_id
	card.stage = Stage.DECK
	card.current_charge = 0
	card.rhythm_context_id = ""
	card.combo_tags = data.combo_tags.duplicate() if data.combo_tags.size() > 0 else []
	return card

## ========== 充能（自包含） ==========
func add_charge(amount: int) -> void:
	current_charge += amount
	if current_charge > data.required_charge:
		current_charge = data.required_charge

func is_fully_charged() -> bool:
	return current_charge >= data.required_charge

func get_charge_progress() -> Dictionary:
	return {
		"current": current_charge,
		"required": data.required_charge,
		"ratio": float(current_charge) / data.required_charge if data.required_charge > 0 else 1.0
	}

## ========== 重置（复用卡牌时） ==========
func reset() -> void:
	stage = Stage.DECK
	current_charge = 0
	rhythm_context_id = ""
```

